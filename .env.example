# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional personal API key for OpenAI ChatGPT models (e.g. gpt-4o, gpt-4o-mini)
OPENAI_API_KEY=""

# GROK_API_KEY: Optional personal API key for xAI Grok models (e.g. grok-2-latest, grok-beta)
GROK_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
